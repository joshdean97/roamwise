# Required
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-value
DATABASE_URL=postgresql://user:password@host:5432/leaveprints
PUBLIC_APP_URL=https://leaveprints.com

# Managed hosts normally terminate TLS at a reverse proxy.
# Enable this only when your host documents X-Forwarded-* headers.
TRUST_PROXY_HEADERS=1

# Production cookies/HSTS default to secure when APP_ENV=production,
# but these are shown explicitly for clarity.
SESSION_COOKIE_SECURE=1
REMEMBER_COOKIE_SECURE=1
ENABLE_HSTS=1

# Transactional email (password reset + account confirmation)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_USE_TLS=0
SMTP_USE_SSL=1
MAIL_FROM=LeavePrints <no-reply@leaveprints.com>
PASSWORD_RESET_MAX_AGE_SECONDS=3600
PASSWORD_RESET_LOG_LINKS=0
EMAIL_CONFIRMATION_MAX_AGE_SECONDS=86400
EMAIL_CONFIRMATION_LOG_LINKS=0

# Rate limiting. Keep WEB_CONCURRENCY=1 while using memory://.
# Before scaling to multiple workers/instances, switch this to Redis.
RATELIMIT_STORAGE_URI=memory://
WEB_CONCURRENCY=1
WEB_THREADS=4

# Usually supplied by the hosting platform.
PORT=8000
